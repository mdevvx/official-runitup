# ============================================================
# REQUIRED - the bot will not start without these
# ============================================================

# Discord
DISCORD_TOKEN=your_discord_bot_token
GUILD_ID=your_server_id
ADMIN_ROLE_ID=your_admin_role_id
MOD_ROLE_ID=your_mod_role_id

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Dialed -> RunItUp wins relay (cogs/wins_relay.py). Required - do not remove.
DIALED_GUILD_ID=dialed_server_id
DIALED_WINS_CHANNEL_ID=dialed_wins_channel_id
RUNITUP_WINS_CHANNEL_ID=runitup_wins_channel_id

# ============================================================
# OPTIONAL - everything below is safe to leave unset
# ============================================================

# Channel IDs - legacy fallbacks only. The real way to configure these is the
# /<season> setchannel slash command (e.g. /q2 setchannel channel_type:value_drops
# channel:#sauce), which stores the ID in the bot_config table and takes
# priority over whatever's here. These env vars are only used if a channel
# type has never been registered via that command. Safe to leave blank/unset.
LEADERBOARD_CHANNEL_ID=channel_id
WINS_CHANNEL_ID=channel_id
VALUE_DROPS_CHANNEL_ID=channel_id
ANNOUNCEMENTS_CHANNEL_ID=channel_id
DAILY_TODO_CHANNEL_ID=channel_id
CALLS_CHANNEL_ID=channel_id
LOG_CHANNEL_ID=channel_id

# Challenge dates are NOT set here anymore - command-only, via
# /<season> setchallengedates (e.g. /q2 setchallengedates start_date:2026-07-01
# end_date:2026-07-31 timezone:US/Eastern). is_challenge_active() gates ALL
# point awarding, so nothing earns points until that command has been run.

PRIZE_AMOUNT=1000

# Point Limits (all have sane defaults if unset)
MAX_REFERRALS=10
MAX_VALUE_POSTS_PER_DAY=2
MAX_POINTS_PER_POST=30

# Branding (has a placeholder default if unset)
LEADERBOARD_IMAGE_URL=https://your-image-url-here.com/leaderboard.png
